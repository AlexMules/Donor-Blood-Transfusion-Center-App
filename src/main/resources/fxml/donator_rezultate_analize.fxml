<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="800.0" prefWidth="1000.0" spacing="20.0" styleClass="root" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.alex.donor.controller.DonatorRezultateController">
    <children>
        <HBox alignment="CENTER_LEFT">
            <VBox.margin><Insets left="50.0" top="40.0" /></VBox.margin>
            <children>
                <Label text="Rezultate Analize" textFill="WHITE">
                    <font><Font name="System Bold" size="40.0" /></font>
                </Label>
            </children>
        </HBox>

        <VBox alignment="CENTER" VBox.vgrow="ALWAYS">
            <padding><Insets left="50.0" right="50.0" /></padding>
            <children>
                <ListView fx:id="listaRezultate" maxWidth="850.0" prefHeight="550.0" style="-fx-background-color: transparent; -fx-background: transparent;" />
            </children>
        </VBox>

        <HBox alignment="BOTTOM_LEFT">
            <padding><Insets bottom="40.0" left="50.0" /></padding>
            <children>
                <Button fx:id="btnBack" onAction="#handleBack" prefHeight="45.0" prefWidth="120.0" styleClass="btn-back" text="Înapoi" />
            </children>
        </HBox>
    </children>
</VBox>