<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="750.0" prefWidth="950.0" spacing="30.0" styleClass="root" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.alex.donor.controller.ProgramareController">
    <children>
        <Label text="Programare" textFill="WHITE">
            <font>
                <Font name="System Bold" size="48.0" />
            </font>
            <VBox.margin>
                <Insets top="40.0" />
            </VBox.margin>
        </Label>

        <HBox alignment="CENTER" spacing="50.0" VBox.vgrow="ALWAYS">
            <children>
                <VBox fx:id="boxGreen" alignment="CENTER" prefHeight="400.0" prefWidth="420.0" spacing="30.0" styleClass="appointment-box-green">
                    <children>
                        <GridPane alignment="CENTER" hgap="15.0" vgap="35.0">
                            <columnConstraints>
                                <ColumnConstraints halignment="RIGHT" hgrow="SOMETIMES" minWidth="10.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                            </rowConstraints>
                            <children>
                                <Label text="Alege ziua:" textFill="WHITE">
                                    <font><Font name="System Bold" size="20.0" /></font>
                                </Label>
                                <DatePicker fx:id="datePickerZiua" prefHeight="45.0" prefWidth="220.0" styleClass="combo-capsule" GridPane.columnIndex="1" />

                                <Label text="Alege ora:" textFill="WHITE" GridPane.rowIndex="1">
                                    <font><Font name="System Bold" size="20.0" /></font>
                                </Label>
                                <ComboBox fx:id="comboOra" prefHeight="45.0" prefWidth="220.0" styleClass="combo-capsule" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                            </children>
                        </GridPane>

                        <Button onAction="#handleSchedule" prefHeight="55.0" prefWidth="220.0" styleClass="btn-action-white" text="Programează-te">
                            <VBox.margin><Insets top="45.0" /></VBox.margin>
                        </Button>
                    </children>
                </VBox>

                <VBox fx:id="boxPurple" alignment="CENTER" prefHeight="400.0" prefWidth="420.0" spacing="25.0" styleClass="appointment-box-purple">
                    <children>
                        <Label text="Programarea ta" textFill="WHITE">
                            <font><Font name="System Bold" size="26.0" /></font>
                        </Label>
                        <VBox alignment="CENTER" maxWidth="320.0" prefHeight="130.0" spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 15;">
                            <children>
                                <Label fx:id="lblInfoZiua" text="Ziua: --.--.----" textFill="BLACK">
                                    <font><Font name="System Bold" size="22.0" /></font>
                                </Label>
                                <Label fx:id="lblInfoOra" text="Ora: --:--" textFill="BLACK">
                                    <font><Font name="System Bold" size="22.0" /></font>
                                </Label>
                            </children>
                        </VBox>
                        <Button onAction="#handleCancel" prefHeight="55.0" prefWidth="260.0" styleClass="btn-action-white" text="Anulează programarea" textFill="#e40000">
                            <VBox.margin><Insets top="20.0" /></VBox.margin>
                        </Button>
                    </children>
                </VBox>
            </children>
        </HBox>

        <HBox alignment="BOTTOM_LEFT">
            <children>
                <Button fx:id="btnBack" onAction="#handleBack" prefHeight="45.0" prefWidth="120.0" styleClass="btn-back" text="Înapoi" />
            </children>
            <padding>
                <Insets bottom="40.0" left="50.0" />
            </padding>
        </HBox>
    </children>
</VBox>