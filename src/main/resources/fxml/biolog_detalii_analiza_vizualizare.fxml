<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="850.0" prefWidth="950.0" spacing="20.0" styleClass="root" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.alex.donor.controller.BiologVizualizareDetaliiController">
    <children>
        <Label text="Detalii Rezultat Analiză" textFill="WHITE">
            <font><Font name="System Bold" size="36.0" /></font>
            <VBox.margin><Insets top="40.0" bottom="20.0" /></VBox.margin>
        </Label>

        <StackPane VBox.vgrow="ALWAYS">
            <children>
                <GridPane alignment="CENTER" hgap="15.0" maxWidth="-Infinity" vgap="15.0">
                    <columnConstraints>
                        <ColumnConstraints halignment="RIGHT" hgrow="SOMETIMES" minWidth="280.0" prefWidth="300.0" />
                        <ColumnConstraints halignment="LEFT" hgrow="SOMETIMES" minWidth="300.0" prefWidth="450.0" />
                    </columnConstraints>

                    <children>
                        <Label text="Nume Donator:" textFill="WHITE" GridPane.rowIndex="0">
                            <font><Font name="System Bold" size="18.0" /></font>
                        </Label>
                        <TextField fx:id="txtNume" editable="false" prefHeight="45.0" styleClass="combo-capsule" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                        <Label text="Prenume Donator:" textFill="WHITE" GridPane.rowIndex="1">
                            <font><Font name="System Bold" size="18.0" /></font>
                        </Label>
                        <TextField fx:id="txtPrenume" editable="false" prefHeight="45.0" styleClass="combo-capsule" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                        <Label text="Data Donării:" textFill="WHITE" GridPane.rowIndex="2">
                            <font><Font name="System Bold" size="18.0" /></font>
                        </Label>
                        <TextField fx:id="txtDataDonare" editable="false" prefHeight="45.0" styleClass="combo-capsule" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                        <Label text="Data Introducerii Rezultatului:" textFill="WHITE" GridPane.rowIndex="3">
                            <font><Font name="System Bold" size="18.0" /></font>
                        </Label>
                        <TextField fx:id="txtDataRezultat" editable="false" prefHeight="45.0" styleClass="combo-capsule" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                        <Label text="Grupa Sanguină:" textFill="WHITE" GridPane.rowIndex="4">
                            <font><Font name="System Bold" size="18.0" /></font>
                        </Label>
                        <TextField fx:id="txtGrupa" editable="false" prefHeight="45.0" maxWidth="150.0" styleClass="combo-capsule" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                        <Label text="RH:" textFill="WHITE" GridPane.rowIndex="5">
                            <font><Font name="System Bold" size="18.0" /></font>
                        </Label>
                        <TextField fx:id="txtRh" editable="false" prefHeight="45.0" maxWidth="150.0" styleClass="combo-capsule" GridPane.columnIndex="1" GridPane.rowIndex="5" />

                        <Label text="Cantitate (ml):" textFill="WHITE" GridPane.rowIndex="6">
                            <font><Font name="System Bold" size="18.0" /></font>
                        </Label>
                        <TextField fx:id="txtCantitate" editable="false" prefHeight="45.0" maxWidth="150.0" styleClass="combo-capsule" GridPane.columnIndex="1" GridPane.rowIndex="6" />

                        <Label text="Rezultat:" textFill="WHITE" GridPane.rowIndex="7">
                            <font><Font name="System Bold" size="18.0" /></font>
                        </Label>
                        <TextField fx:id="txtRezultat" editable="false" prefHeight="45.0" styleClass="combo-capsule" style="-fx-font-weight: bold;" GridPane.columnIndex="1" GridPane.rowIndex="7" />

                        <Label text="Observații / Mesaj:" textFill="WHITE" GridPane.rowIndex="8">
                            <font><Font name="System Bold" size="18.0" /></font>
                        </Label>
                        <TextArea fx:id="txtMesaj" editable="false" maxWidth="450.0" prefHeight="150.0" prefWidth="450.0" wrapText="true"
                                  style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-opacity: 1.0;"
                                  GridPane.columnIndex="1" GridPane.rowIndex="8" />
                    </children>
                </GridPane>
            </children>
        </StackPane>

        <HBox alignment="BOTTOM_LEFT">
            <padding><Insets bottom="40.0" left="50.0" /></padding>
            <children>
                <Button fx:id="btnBack" onAction="#handleBack" prefHeight="45.0" prefWidth="120.0" styleClass="btn-back" text="Înapoi" />
            </children>
        </HBox>
    </children>
</VBox>