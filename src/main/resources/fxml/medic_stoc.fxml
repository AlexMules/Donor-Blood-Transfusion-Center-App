<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="750.0" prefWidth="950.0" spacing="20.0" styleClass="root" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.alex.donor.controller.MedicStocController">
    <children>
        <HBox alignment="TOP_LEFT">
            <VBox.margin><Insets left="40.0" top="40.0" /></VBox.margin>
            <children>
                <Label text="Stoc Sânge Disponibil" textFill="WHITE">
                    <font><Font name="System Bold" size="40.0" /></font>
                </Label>
            </children>
        </HBox>

        <VBox alignment="CENTER" VBox.vgrow="ALWAYS">
            <padding><Insets left="40.0" right="40.0" /></padding>
            <children>
                <TableView fx:id="tabelStoc" maxWidth="900.0" prefHeight="550.0" styleClass="modern-table-large">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colGrupa" prefWidth="300.0" text="Grupă Sanguină" />
                        <TableColumn fx:id="colRh" prefWidth="300.0" text="RH" />
                        <TableColumn fx:id="colCantitate" prefWidth="300.0" text="Cantitate Disponibilă (mL)" />
                    </columns>
                </TableView>
            </children>
        </VBox>

        <HBox alignment="BOTTOM_LEFT">
            <padding><Insets bottom="40.0" left="50.0" /></padding>
            <children>
                <Button fx:id="btnBack" onAction="#handleBack" prefHeight="45.0" prefWidth="120.0" styleClass="btn-back" text="Înapoi" />
            </children>
        </HBox>
    </children>
</VBox>