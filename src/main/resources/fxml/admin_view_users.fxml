<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="800.0" prefWidth="1000.0" spacing="25.0" styleClass="root" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.alex.donor.controller.AdminViewUsersController">
    <children>
        <Label text="Gestionare Conturi Personal" textFill="WHITE">
            <font><Font name="System Bold" size="40.0" /></font>
            <VBox.margin><Insets top="40.0" /></VBox.margin>
        </Label>

        <VBox alignment="CENTER" VBox.vgrow="ALWAYS">
            <padding><Insets left="40.0" right="40.0" /></padding>
            <children>
                <TableView fx:id="tabelUtilizatori" prefHeight="500.0" styleClass="custom-table">
                    <columns>
                        <TableColumn fx:id="colNume" prefWidth="220.0" text="Nume" />
                        <TableColumn fx:id="colPrenume" prefWidth="220.0" text="Prenume" />
                        <TableColumn fx:id="colRol" prefWidth="180.0" text="Rol" />
                        <TableColumn fx:id="colActiuni" prefWidth="250.0" text="Acțiuni" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>

        <HBox alignment="BOTTOM_LEFT">
            <padding><Insets bottom="40.0" left="50.0" /></padding>
            <children>
                <Button fx:id="btnBack" onAction="#handleBack" prefHeight="45.0" prefWidth="130.0" styleClass="btn-back" text="Înapoi" />
            </children>
        </HBox>
    </children>
</VBox>