<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="750.0" prefWidth="950.0" styleClass="root" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.alex.donor.controller.BiologController">
    <children>
        <HBox alignment="TOP_LEFT" prefWidth="950.0">
            <VBox.margin>
                <Insets left="40.0" top="40.0" />
            </VBox.margin>
            <children>
                <Label text="Biolog" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="48.0" />
                    </font>
                </Label>
            </children>
        </HBox>

        <VBox alignment="CENTER" spacing="20.0" VBox.vgrow="ALWAYS">
            <children>
                <Label text="Selectează acțiunea dorită:" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="10.0" />
                    </VBox.margin>
                </Label>

                <Button onAction="#handleIntroducereRezultate" prefHeight="65.0" prefWidth="400.0" styleClass="admin-menu-button" text="Introducere rezultate" />

                <Button onAction="#handleVizualizareRezultate" prefHeight="65.0" prefWidth="400.0" styleClass="admin-menu-button" text="Vizualizare rezultate" />

                <Button onAction="#handleVizualizareStoc" prefHeight="65.0" prefWidth="400.0" styleClass="admin-menu-button" text="Vizualizare stoc de sânge" />

                <Button onAction="#handleVizualizareDatePersonale" prefHeight="65.0" prefWidth="400.0" styleClass="admin-menu-button" text="Vizualizare date personale" />
            </children>
        </VBox>

        <Button fx:id="btnLogout" onAction="#handleLogout" prefHeight="50.0" prefWidth="250.0" styleClass="admin-menu-button" text="Deautentificare">
            <VBox.margin>
                <Insets bottom="50.0" />
            </VBox.margin>
        </Button>
    </children>
</VBox>