<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="750.0" prefWidth="950.0" spacing="20.0" styleClass="root" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.alex.donor.controller.MedicProgramariController">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="30.0">
            <VBox.margin><Insets left="40.0" top="40.0" right="40.0" /></VBox.margin>
            <children>
                <Label text="Vizualizare Programări" textFill="WHITE">
                    <font><Font name="System Bold" size="40.0" /></font>
                </Label>
                <Region HBox.hgrow="ALWAYS" />
                <VBox spacing="5.0">
                    <children>
                        <Label text="Alege ziua:" textFill="WHITE">
                            <font><Font name="System Bold" size="16.0" /></font>
                        </Label>
                        <DatePicker fx:id="datePickerZi" onAction="#handleDateChange" prefHeight="40.0" prefWidth="200.0" styleClass="combo-capsule" />
                    </children>
                </VBox>
            </children>
        </HBox>

        <VBox alignment="CENTER" VBox.vgrow="ALWAYS">
            <padding><Insets left="40.0" right="40.0" /></padding>
            <children>
                <TableView fx:id="tabelProgramari" maxWidth="900.0" prefHeight="500.0" styleClass="modern-table-large">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colNr" maxWidth="80.0" minWidth="80.0" text="Nr." />
                        <TableColumn fx:id="colNume" text="Nume" />
                        <TableColumn fx:id="colPrenume" text="Prenume" />
                        <TableColumn fx:id="colOra" maxWidth="150.0" minWidth="150.0" text="Ora" />
                        <TableColumn fx:id="colActiuni" maxWidth="200.0" minWidth="200.0" text="Acțiuni" />
                    </columns>
                </TableView>
            </children>
        </VBox>

        <HBox alignment="BOTTOM_LEFT">
            <padding><Insets bottom="40.0" left="50.0" /></padding>
            <children>
                <Button fx:id="btnBack" onAction="#handleBack" prefHeight="45.0" prefWidth="120.0" styleClass="btn-back" text="Înapoi" />
            </children>
        </HBox>
    </children>
</VBox>