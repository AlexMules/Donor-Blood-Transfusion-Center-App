<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="750.0" prefWidth="950.0" spacing="25.0" styleClass="root" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.alex.donor.controller.AdminDeleteUserController">
    <children>
        <Label text="Ștergere Cont Personal Medical" textFill="WHITE">
            <font>
                <Font name="System Bold" size="32.0" />
            </font>
            <VBox.margin>
                <Insets top="40.0" />
            </VBox.margin>
        </Label>

        <TableView fx:id="userTable" maxWidth="850.0" prefHeight="450.0" styleClass="custom-table">
            <columns>
                <TableColumn fx:id="colNume" prefWidth="150.0" text="Nume" />
                <TableColumn fx:id="colPrenume" prefWidth="150.0" text="Prenume" />
                <TableColumn fx:id="colRol" prefWidth="120.0" text="Rol" />
                <TableColumn fx:id="colActiune" prefWidth="300.0" text="Acțiune" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <VBox.margin>
                <Insets left="40.0" right="40.0" />
            </VBox.margin>
        </TableView>

        <HBox alignment="BOTTOM_LEFT" VBox.vgrow="ALWAYS">
            <children>
                <Button fx:id="btnBack" onAction="#handleBack" prefHeight="45.0" prefWidth="120.0" styleClass="btn-back" text="Înapoi" />
            </children>
            <padding>
                <Insets bottom="30.0" left="40.0" />
            </padding>
        </HBox>
    </children>
</VBox>