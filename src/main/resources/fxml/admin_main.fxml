<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="600.0" prefWidth="900.0" spacing="30.0" styleClass="root" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.alex.donor.controller.AdminController">
    <children>
        <VBox alignment="TOP_LEFT" prefWidth="200.0">
            <children>
                <Label text="Administrator" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="40.0" />
                    </font>
                </Label>
            </children>
            <VBox.margin>
                <Insets left="50.0" top="40.0" />
            </VBox.margin>
        </VBox>

        <VBox alignment="CENTER" spacing="20.0" VBox.vgrow="ALWAYS">
            <children>
                <Label text="Selectează acțiunea dorită:" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="20.0" />
                    </VBox.margin>
                </Label>

                <Button mnemonicParsing="false" onAction="#handleAddAccount"
                        prefHeight="65.0" prefWidth="400.0"
                        styleClass="admin-menu-button" text="Adăugare cont nou" />

                <Button mnemonicParsing="false" onAction="#handleDeleteAccount"
                        prefHeight="65.0" prefWidth="400.0"
                        styleClass="admin-menu-button" text="Ștergere cont existent" />

                <Button mnemonicParsing="false" onAction="#handleViewPersonalData"
                        prefHeight="65.0" prefWidth="400.0"
                        styleClass="admin-menu-button" text="Vizualizare date personale" />
            </children>
        </VBox>

        <Button fx:id="btnLogout" mnemonicParsing="false" onAction="#handleLogout" prefHeight="45.0" prefWidth="200.0" styleClass="button-secondary" text="Deautentificare">
            <VBox.margin>
                <Insets bottom="50.0" />
            </VBox.margin>
        </Button>
    </children>
</VBox>